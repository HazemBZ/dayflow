{
  "$schema": "https://raw.githubusercontent.com/nicehash/tauri/refs/heads/dev/crates/tauri-cli/config.schema.json",
  "productName": "Dayflow",
  "version": "0.1.3",
  "identifier": "com.dayflow.app",
  "build": {
    "beforeDevCommand": "bash scripts/dev.sh",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bash scripts/build-sidecar.sh",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "Dayflow",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/dayflow-server"],
    "resources": {
      "../.next/standalone/server.js": "server/server.js",
      "../.next/standalone/package.json": "server/package.json",
      "../.next/standalone/.next": "server/.next",
      "../.next/standalone/public": "server/public",
      "../.next/standalone/node_modules": "server/node_modules",
      "../drizzle": "server/drizzle",
      "../scripts/migrate.mjs": "server/scripts/migrate.mjs"
    }
  }
}
